        "ai_security",
        "privacy",
        "appsec"
      ],
      "embedded / hardware / systems": [
        "embedded",
        "systems",
        "programming"
      ],
      "public interest / federal / nonprofit": [
        "public_service",
        "all"
      ],
      "GRC / risk / audit / banking": [
        "vuln",
        "defensive",
        "documentation",
        "privacy",
        "communication"
      ]
    },
    "lead_with": "The experience entry whose claims best match the posting's primary responsibilities, not always the most recent one.",
    "no_grc_experience": "You have NO governance, risk, or compliance experience. No NIST/ISO/CIS framework work, no audits, no policy writing, no risk registers, no regulatory remediation. For GRC-flavored roles, lead with vulnerability assessment, implementing and verifying controls, and documentation, and frame compliance frameworks as something to learn. Never imply framework or audit experience.",
    "merge_pairs": []
  },
