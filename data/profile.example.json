  "assembly_rules": {
    "principle": "Select and order existing claims by relevance to the posting. Never write a new claim, never merge two claims into a stronger one, never soften a qualifier. If the posting wants something not in the pool, leave it out rather than stretching.",
    "resume_bullets": "Pick 3 claims per experience entry, ordered by relevance to the posting. Merge closely related claims into one bullet ONLY when both are true as written and the merge adds no new assertion.",
    "skills_field": "Filter skill_pool by the posting's tags. Order most-relevant first. Default 10 items; expand if the field allows more. Never include anything from NEVER_CLAIM even if the posting asks for it.",
    "role_type_tags": {
      "offensive / red team / RE / vuln research": [
        "offensive",
        "vuln",
        "reverse_engineering",
        "appsec"
      ],
      "blue team / SOC / detection / monitoring": [
        "defensive",
        "detection",
        "monitoring",
        "networking"
      ],
