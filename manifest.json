{
  "manifest_version": 3,
  "name": "Job Autofill",
  "version": "1.0.0",
  "description": "Fills job application forms from a local profile. Reads only. Never submits.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Fill this application"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
